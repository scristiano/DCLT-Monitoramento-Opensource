{
    "_comment": "Este arquivo é um template. O script setup-eks.sh criará a policy com os nomes corretos dos buckets incluindo o Account ID.",
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowListBuckets",
            "Effect": "Allow",
            "Action": [
                "s3:ListBucket",
                "s3:GetBucketLocation"
            ],
            "Resource": [
                "arn:aws:s3:::loki-observability-lab-chunks-ACCOUNT_ID",
                "arn:aws:s3:::loki-observability-lab-ruler-ACCOUNT_ID",
                "arn:aws:s3:::loki-observability-lab-admin-ACCOUNT_ID"
            ]
        },
        {
            "Sid": "AllowObjectOperations",
            "Effect": "Allow",
            "Action": [
                "s3:PutObject",
                "s3:GetObject",
                "s3:DeleteObject"
            ],
            "Resource": [
                "arn:aws:s3:::loki-observability-lab-chunks-ACCOUNT_ID/*",
                "arn:aws:s3:::loki-observability-lab-ruler-ACCOUNT_ID/*",
                "arn:aws:s3:::loki-observability-lab-admin-ACCOUNT_ID/*"
            ]
        }
    ]
}
